---
import '../styles/global.css';
import { LOCALES, LOCALE_KEY, type Locale } from '../i18n';
import { LANDING_COPY, landingUrl } from '../i18n/landing';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = LANDING_COPY[locale];

const canonical = landingUrl(locale);
const siteUrl = landingUrl('id');

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: 'Trackora',
      alternateName: 'Trackora Web ID',
      url: siteUrl,
      inLanguage: LOCALES.map((entry) => entry.htmlLang),
      publisher: { '@id': `${siteUrl}#organization` },
    },
    {
      '@type': 'Organization',
      '@id': `${siteUrl}#organization`,
      name: 'Trackora',
      url: siteUrl,
      sameAs: ['https://github.com/Ciptaaaa/Frontend_Trackora'],
    },
  ],
};
---

<!doctype html>
<html lang={copy.htmlLang} class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{copy.documentTitle}</title>
    <meta name="description" content={copy.metaDescription} />
    <link rel="canonical" href={canonical} />
    {
      LOCALES.map((entry) => (
        <link
          rel="alternate"
          hreflang={entry.htmlLang}
          href={landingUrl(entry.code)}
        />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={landingUrl('id')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Trackora" />
    <meta property="og:title" content={copy.documentTitle} />
    <meta property="og:description" content={copy.metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={copy.ogLocale} />
    <meta name="theme-color" content="#f7f7f5" />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />
    <script is:inline>
      (() => {
        const meta = document.querySelector('meta[name="theme-color"]');
        if (!meta) return;
        const sync = () => {
          meta.setAttribute(
            'content',
            document.documentElement.classList.contains('dark')
              ? '#191919'
              : '#f7f7f5',
          );
        };
        new MutationObserver(sync).observe(document.documentElement, {
          attributes: true,
          attributeFilter: ['class'],
        });
        sync();
      })();
    </script>

    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('trackora.v1.theme');
          const preference =
            stored === 'light' || stored === 'dark' || stored === 'system'
              ? stored
              : 'system';
          const dark =
            preference === 'dark' ||
            (preference === 'system' &&
              window.matchMedia('(prefers-color-scheme: dark)').matches);

          document.documentElement.classList.toggle('dark', dark);
          document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
        } catch {}
      })();
    </script>
  </head>
  <body class="h-full bg-paper-100 antialiased">
    <slot />
    <script is:inline define:vars={{ storageKey: LOCALE_KEY }}>
      document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;

        const link = target.closest('[data-locale-links] a[data-locale]');
        if (!link) return;

        try {
          localStorage.setItem(storageKey, link.dataset.locale);
        } catch {}
      });
    </script>
  </body>
</html>
