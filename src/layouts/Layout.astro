---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Trackora',
  description = 'Papan kerja pribadi, lacak apa yang sedang jalan dan kapan jatuh temponya.',
} = Astro.props;
---

<!doctype html>
<html lang="id" class="w-auto h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content="nuRkMXFMe9W2MTwUlRI-NYn4y6XaVvu6sRYNvYCtZ5s" />
    <meta name="theme-color" content="#f7f7f5" />
    <script is:inline>
      (() => {
        const meta = document.querySelector('meta[name="theme-color"]');
        if (!meta) return;
        const sync = () => {
          meta.setAttribute(
            'content',
            document.documentElement.classList.contains('dark')
              ? '#191919'
              : '#f7f7f5',
          );
        };
        new MutationObserver(sync).observe(document.documentElement, {
          attributes: true,
          attributeFilter: ['class'],
        });
        sync();
      })();
    </script>

    <title>{title}</title>
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('trackora.v1.theme');
          const preference = stored === 'light' || stored === 'dark' || stored === 'system'
            ? stored
            : 'system';
          const dark =
            preference === 'dark' ||
            (preference === 'system' &&
              window.matchMedia('(prefers-color-scheme: dark)').matches);

          document.documentElement.classList.toggle('dark', dark);
          document.documentElement.style.colorScheme = dark ? 'dark' : 'light';

          const locale = localStorage.getItem('trackora.v1.locale');
          if (locale === 'en' || locale === 'zh' || locale === 'id') {
            document.documentElement.lang = locale === 'zh' ? 'zh-CN' : locale;
          }
        } catch {
        }
      })();
    </script>
  </head>
  <body class="h-full bg-paper-200 antialiased">
    <slot />
  </body>
</html>
