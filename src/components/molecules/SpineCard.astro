---
import DueChip from '../atoms/DueChip.astro';
import type { SpineCard } from '../../i18n/landing';

interface Props {
  card: SpineCard;
}

const { card } = Astro.props;

const columnClass: Record<SpineCard['startDay'], string> = {
  1: 'sm:col-start-1',
  2: 'sm:col-start-2',
  3: 'sm:col-start-3',
  4: 'sm:col-start-4',
  5: 'sm:col-start-5',
  6: 'sm:col-start-6',
};
---

<article
  class:list={[
    'col-span-1 sm:col-span-2',
    columnClass[card.startDay],
    'rounded-xl bg-paper-50 p-3 shadow-sm ring-1 ring-paper-300',
  ]}
>
  <p class="text-[13px] leading-snug font-medium text-ink-800">
    {card.title}
  </p>
  <div class="mt-2">
    <DueChip tone={card.tone} label={card.due} />
  </div>
</article>
