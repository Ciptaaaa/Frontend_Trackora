---
import { LOCALES, type Locale } from '../../i18n';
import { landingPath } from '../../i18n/landing';

interface Props {
  current: Locale;
  tone?: 'ink' | 'nav';
}

const { current, tone = 'ink' } = Astro.props;

const inkTone = {
  idle: 'text-ink-400 hover:bg-paper-200 hover:text-ink-900',
  active: 'bg-paper-200 text-ink-900',
};

const navTone = {
  idle: 'text-nav-muted hover:bg-nav-raised hover:text-nav-text',
  active: 'bg-nav-raised text-nav-text',
};

const palette = tone === 'nav' ? navTone : inkTone;
---

<nav data-locale-links class="flex items-center gap-0.5">
  {
    LOCALES.map((entry) => (
      <a
        href={landingPath(entry.code)}
        hreflang={entry.htmlLang}
        lang={entry.htmlLang}
        data-locale={entry.code}
        aria-current={entry.code === current ? 'true' : undefined}
        class:list={[
          'rounded-lg px-2.5 py-1.5 font-mono text-[11px] tracking-[0.08em] transition-colors',
          entry.code === current ? palette.active : palette.idle,
        ]}
      >
        {entry.short}
        <span class="sr-only"> — {entry.label}</span>
      </a>
    ))
  }
</nav>
