---
import type { LandingCopy } from '../../i18n/landing';

interface Props {
  copy: LandingCopy;
  compact?: boolean;
}

const { copy, compact = false } = Astro.props;

const options = [
  { value: 'light', label: copy.themeLight, icon: 'sun' },
  { value: 'dark', label: copy.themeDark, icon: 'moon' },
  { value: 'system', label: copy.themeSystem, icon: 'monitor' },
] as const;

const ICONS = {
  sun: 'M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8M12 2v2M12 20v2M4 12H2M22 12h-2M5.6 5.6 4.2 4.2M19.8 19.8l-1.4-1.4M18.4 5.6l1.4-1.4M4.2 19.8l1.4-1.4',
  moon: 'M20 14.5A8.5 8.5 0 0 1 9.5 4a7 7 0 1 0 10.5 10.5',
  monitor: 'M4 5h16v10H4zM9 19h6M12 15v4',
} as const;
---

{
  compact ? (
    <button
      type="button"
      data-theme-compact
      data-theme-prefix={copy.themeLabel}
      data-theme-label-light={copy.themeLight}
      data-theme-label-dark={copy.themeDark}
      title={copy.themeLabel}
      aria-label={copy.themeLabel}
      class="inline-flex size-11 items-center justify-center rounded-lg border border-paper-300 bg-paper-50 text-ink-600 transition-colors hover:bg-paper-100 hover:text-ink-900 dark:border-paper-400"
    >
      <span data-theme-compact-icon="light">
        <svg
          viewBox="0 0 24 24"
          class="size-4"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d={ICONS.sun} />
        </svg>
      </span>
      <span data-theme-compact-icon="dark" hidden>
        <svg
          viewBox="0 0 24 24"
          class="size-4"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d={ICONS.moon} />
        </svg>
      </span>
    </button>
  ) : (
    <div
      data-theme-toggle
      role="group"
      aria-label={copy.themeLabel}
      class="inline-flex items-center gap-1 rounded-lg border border-paper-300 bg-paper-50 p-0.5 dark:border-paper-400"
    >
      {options.map((option) => (
        <button
          type="button"
          data-theme-value={option.value}
          title={option.label}
          aria-label={option.label}
          aria-pressed="false"
          class="inline-flex size-11 items-center justify-center rounded-md text-ink-400 transition-colors hover:bg-paper-100 hover:text-ink-900"
        >
          <svg
            viewBox="0 0 24 24"
            class="size-4"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d={ICONS[option.icon]} />
          </svg>
        </button>
      ))}
    </div>
  )
}

<script is:inline>
  (() => {
    if (window.__trackoraLandingTheme === true) return;
    window.__trackoraLandingTheme = true;

    const KEY = 'trackora.v1.theme';
    const root = document.documentElement;
    const media = window.matchMedia('(prefers-color-scheme: dark)');

    function read() {
      try {
        const stored = localStorage.getItem(KEY);
        return stored === 'light' || stored === 'dark' || stored === 'system'
          ? stored
          : 'system';
      } catch {
        return 'system';
      }
    }

    function apply(preference, persist) {
      const dark =
        preference === 'dark' ||
        (preference === 'system' && media.matches);

      root.classList.toggle('dark', dark);
      root.style.colorScheme = dark ? 'dark' : 'light';

      if (persist) {
        try {
          localStorage.setItem(KEY, preference);
        } catch {
        }
      }

      document.querySelectorAll('[data-theme-value]').forEach((button) => {
        const active = button.getAttribute('data-theme-value') === preference;
        button.setAttribute('aria-pressed', active ? 'true' : 'false');
        button.classList.toggle('bg-petrol-50', active);
        button.classList.toggle('text-petrol-700', active);
        button.classList.toggle('text-ink-400', !active);
      });

      document.querySelectorAll('[data-theme-compact]').forEach((button) => {
        const lightIcon = button.querySelector('[data-theme-compact-icon="light"]');
        const darkIcon = button.querySelector('[data-theme-compact-icon="dark"]');
        if (lightIcon) lightIcon.hidden = dark;
        if (darkIcon) darkIcon.hidden = !dark;

        const prefix = button.getAttribute('data-theme-prefix');
        const label = button.getAttribute(
          dark ? 'data-theme-label-dark' : 'data-theme-label-light',
        );
        if (prefix && label) {
          const text = `${prefix}: ${label}`;
          button.setAttribute('aria-label', text);
          button.setAttribute('title', text);
        }
      });
    }

    function boot() {
      apply(read(), false);
    }

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const compact = target.closest('[data-theme-compact]');
      if (compact) {
        apply(root.classList.contains('dark') ? 'light' : 'dark', true);
        return;
      }

      const button = target.closest('[data-theme-value]');
      if (!button) return;

      apply(button.getAttribute('data-theme-value') || 'system', true);
    });

    media.addEventListener('change', () => {
      if (read() === 'system') apply('system', false);
    });

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', boot);
    } else {
      boot();
    }
  })();
</script>
