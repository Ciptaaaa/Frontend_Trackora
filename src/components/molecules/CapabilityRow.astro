---
import type { Capability } from '../../i18n/landing';

interface Props {
  capability: Capability;
  index: number;
}

const { capability, index } = Astro.props;
---

<div class="border-t border-paper-300 pt-5">
  <div class="flex items-baseline gap-3">
    <span class="text-[11px] font-semibold text-petrol-700 tabular-nums">
      {String(index + 1).padStart(2, '0')}
    </span>
    <p class="text-xs font-medium text-ink-400">{capability.label}</p>
  </div>
  <h3 class="mt-3 text-lg leading-tight font-semibold tracking-[-0.01em] text-ink-900">
    {capability.title}
  </h3>
  <p class="mt-2 max-w-prose text-sm leading-relaxed text-ink-600">
    {capability.body}
  </p>
</div>
