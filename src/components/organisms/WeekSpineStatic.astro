---
import Eyebrow from '../atoms/Eyebrow.astro';
import SpineCard from '../molecules/SpineCard.astro';
import type { LandingCopy } from '../../i18n/landing';
interface Props {
  copy: LandingCopy;
}

const { copy } = Astro.props;

const TODAY_INDEX = 2;

const daysWithCards: ReadonlySet<number> = new Set<number>(
  copy.spineCards.map((card) => card.startDay),
);
---

<figure
  class="overflow-hidden rounded-2xl bg-paper-50 shadow-[0_28px_80px_-34px_rgba(15,15,15,0.3)] ring-1 ring-paper-300 dark:ring-paper-400"
>
  <div
    class="flex items-center gap-2 border-b border-paper-300 bg-paper-100/70 px-4 py-3"
  >
    <span class="flex items-center gap-1.5" aria-hidden="true">
      <span class="size-2.5 rounded-full bg-paper-300"></span>
      <span class="size-2.5 rounded-full bg-paper-300"></span>
      <span class="size-2.5 rounded-full bg-paper-300"></span>
    </span>
    <span class="ml-2 truncate text-xs font-medium text-ink-400">Trackora</span>
    <span
      class="ml-auto rounded-full bg-mint-100 px-2 py-0.5 text-[11px] font-medium text-mint-600"
    >
      {copy.todayLabel}
    </span>
  </div>

  <div class="p-4 sm:p-6">
    <figcaption class="flex items-baseline justify-between gap-4">
      <Eyebrow text={copy.weekEyebrow} />
      <span class="text-[11px] font-medium text-petrol-700">{copy.todayLabel}</span>
    </figcaption>

    <!-- Penggaris hari -->
    <div class="mt-4 grid grid-cols-7 gap-1.5">
      {
        copy.dayInitials.map((initial, index) => (
          <div class="flex flex-col items-center gap-1.5">
            <span
              class:list={[
                'text-xs font-medium',
                index === TODAY_INDEX ? 'text-petrol-700' : 'text-ink-400',
              ]}
            >
              {initial}
            </span>
            <span
              class:list={[
                'h-1 w-full rounded-full',
                index === TODAY_INDEX ? 'bg-petrol-600' : 'bg-paper-300',
              ]}
            />
            <span
              class:list={[
                'size-1 rounded-full',
                daysWithCards.has(index + 1) ? 'bg-petrol-400' : 'bg-transparent',
              ]}
            />
          </div>
        ))
      }
    </div>

    <!-- Kartu, menempel di kolom hari jatuh temponya -->
    <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-7">
      {copy.spineCards.map((card) => <SpineCard card={card} />)}
    </div>
  </div>
</figure>
