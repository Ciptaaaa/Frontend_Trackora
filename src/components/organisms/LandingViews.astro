---
import Eyebrow from '../atoms/Eyebrow.astro';
import DueChip from '../atoms/DueChip.astro';
import type { LandingCopy } from '../../i18n/landing';

interface Props {
  copy: LandingCopy;
}

const { copy } = Astro.props;

const cards = copy.spineCards;
const overdueCard = cards.find((card) => card.tone === 'overdue');
const dueCard = cards.find((card) => card.tone === 'due-soon');
const plainCard = cards.find((card) => card.tone === 'plain');
const daysWithCards = new Set<number>(cards.map((card) => card.startDay));

const columns = [
  {
    title: copy.demoLists[0] ?? '',
    cards: overdueCard === undefined ? [] : [overdueCard],
  },
  {
    title: copy.demoLists[1] ?? '',
    cards: [dueCard, plainCard].filter((card) => card !== undefined),
  },
  {
    title: copy.demoLists[2] ?? '',
    cards: [],
  },
];
---

<section id="tampilan" class="scroll-mt-24 border-y border-paper-300 bg-paper-100">
  <div
    class="mx-auto max-w-6xl px-5 py-20 sm:px-8 lg:grid lg:grid-cols-[0.82fr_1.18fr] lg:items-start lg:gap-16 lg:py-28"
  >
    <div class="lg:sticky lg:top-24">
      <Eyebrow text={copy.viewsEyebrow} />
      <h2
        class="mt-4 max-w-md text-3xl leading-[1.12] font-semibold tracking-[-0.03em] text-balance text-ink-900 sm:text-4xl"
      >
        {copy.viewsHeading}
      </h2>
      <p class="mt-4 max-w-md text-sm leading-relaxed text-ink-600 sm:text-base">
        {copy.viewsBody}
      </p>

      <ol class="mt-10 space-y-7">
        {
          copy.views.map((view, index) => (
            <li class="border-t border-paper-300 pt-5">
              <div class="flex items-baseline gap-3">
                <span class="text-[11px] font-semibold text-petrol-700 tabular-nums">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <span class="text-xs font-medium text-ink-400">{view.label}</span>
              </div>
              <h3 class="mt-2 text-lg leading-tight font-semibold tracking-[-0.01em] text-ink-900">
                {view.title}
              </h3>
              <p class="mt-1.5 max-w-md text-sm leading-relaxed text-ink-600">
                {view.body}
              </p>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="order-first mt-10 lg:order-none lg:mt-0">
      <div
        class="overflow-hidden rounded-2xl bg-paper-50 shadow-[0_28px_80px_-34px_rgba(15,15,15,0.28)] ring-1 ring-paper-300 dark:ring-paper-400"
      >
        <div
          class="flex items-center gap-2 border-b border-paper-300 bg-paper-100/70 px-4 py-3"
        >
          <span class="flex items-center gap-1.5" aria-hidden="true">
            <span class="size-2.5 rounded-full bg-paper-300"></span>
            <span class="size-2.5 rounded-full bg-paper-300"></span>
            <span class="size-2.5 rounded-full bg-paper-300"></span>
          </span>
          <span class="ml-2 truncate text-xs font-medium text-ink-400">Trackora</span>
          <span
            class="ml-auto rounded-full bg-paper-200 px-2 py-0.5 text-[11px] font-medium text-ink-600"
          >
            {copy.weekEyebrow}
          </span>
        </div>

        <div class="p-3 sm:p-4">
          <div class="grid grid-cols-7 gap-1">
            {
              copy.dayInitials.map((initial, index) => (
                <div
                  class:list={[
                    'flex flex-col items-center gap-1 rounded-md px-0.5 py-1',
                    index === 2
                      ? 'bg-petrol-50 text-petrol-700'
                      : 'text-ink-400',
                  ]}
                >
                  <span class="text-[9px] font-medium">{initial}</span>
                  <span class="text-[11px] font-semibold tabular-nums">
                    {index + 1}
                  </span>
                  <span
                    class:list={[
                      'size-1 rounded-full',
                      daysWithCards.has(index + 1)
                        ? 'bg-petrol-600'
                        : 'bg-transparent',
                    ]}
                  />
                </div>
              ))
            }
          </div>

          <div class="mt-3 overflow-x-auto scrollbar-slim">
            <div class="grid min-w-[430px] grid-cols-3 gap-2">
              {
                columns.map((column, index) => (
                  <div class="rounded-lg bg-paper-200 p-2">
                    <div class="flex items-center justify-between gap-2 px-0.5">
                      <span class="truncate text-[10px] font-semibold text-ink-600">
                        {column.title}
                      </span>
                      <span class="rounded-full bg-black/5 px-1.5 py-0.5 text-[9px] font-medium text-ink-400 tabular-nums dark:bg-white/10">
                        {index === 2 ? 1 : column.cards.length}
                      </span>
                    </div>

                    <div class="mt-2 space-y-2">
                      {column.cards.map((card) => (
                        <div class="rounded-md bg-paper-50 p-2 ring-1 ring-paper-300 dark:ring-paper-400/60">
                          <div class="flex gap-1">
                            <span class="h-1 w-4 rounded-full bg-petrol-400" />
                            <span class="h-1 w-3 rounded-full bg-berry-500/70" />
                          </div>
                          <p class="mt-1.5 text-[10px] leading-snug font-medium text-ink-800">
                            {card.title}
                          </p>
                          <div class="mt-1.5">
                            <DueChip tone={card.tone} label={card.due} />
                          </div>
                        </div>
                      ))}

                      {index === 2 && (
                        <div class="rounded-md bg-paper-50 p-2 ring-1 ring-paper-300 dark:ring-paper-400/60">
                          <p class="text-[10px] leading-snug font-medium text-ink-400 line-through">
                            {copy.doneCardTitle}
                          </p>
                          <span class="mt-1.5 inline-flex items-center gap-1 rounded-full bg-mint-100 px-1.5 py-0.5 text-[9px] font-medium text-mint-600">
                            <svg
                              viewBox="0 0 24 24"
                              class="size-2.5"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="2.4"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              aria-hidden="true"
                            >
                              <path d="M5 13l4 4L19 7" />
                            </svg>
                            {copy.doneLabel}
                          </span>
                        </div>
                      )}
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
