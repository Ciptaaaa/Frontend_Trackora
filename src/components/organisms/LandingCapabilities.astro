---
import Eyebrow from '../atoms/Eyebrow.astro';
import CapabilityRow from '../molecules/CapabilityRow.astro';
import type { LandingCopy } from '../../i18n/landing';

interface Props {
  copy: LandingCopy;
}

const { copy } = Astro.props;
---

<section id="kapabilitas" class="border-t border-paper-300 bg-paper-50">
  <div
    class="mx-auto grid max-w-6xl gap-12 px-5 py-20 sm:px-8 lg:grid-cols-[0.85fr_1.15fr] lg:gap-20 lg:py-28"
  >
    <div class="lg:sticky lg:top-24 lg:self-start">
      <Eyebrow text={copy.capabilitiesEyebrow} />
      <h2
        class="mt-4 max-w-md text-3xl leading-[1.12] font-semibold tracking-[-0.03em] text-balance text-ink-900 sm:text-4xl"
      >
        {copy.capabilitiesHeading}
      </h2>
    </div>

    <div class="grid gap-x-12 gap-y-10 sm:grid-cols-2">
      {
        copy.capabilities.map((capability, index) => (
          <CapabilityRow capability={capability} index={index} />
        ))
      }
    </div>
  </div>
</section>
