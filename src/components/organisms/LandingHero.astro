---
import WeekSpineStatic from './WeekSpineStatic.astro';
import TypingHeadline from '../atoms/TypingHeadline.astro';
import type { LandingCopy } from '../../i18n/landing';

interface Props {
  copy: LandingCopy;
}

const { copy } = Astro.props;

const typingSpeed = copy.htmlLang === 'zh-CN' ? 95 : copy.htmlLang === 'en' ? 45 : 55;

const primaryCtaClass =
  'inline-flex h-11 items-center justify-center rounded-lg bg-petrol-600 px-5 text-sm font-medium text-onaccent shadow-sm shadow-petrol-600/20 transition-colors hover:bg-petrol-700';

const secondaryCtaClass =
  'inline-flex h-11 items-center justify-center rounded-lg bg-paper-50 px-5 text-sm font-medium text-ink-800 ring-1 ring-paper-300 transition-colors hover:bg-paper-200 hover:text-ink-900 dark:ring-paper-400';
---

<section class="mx-auto max-w-6xl px-5 pt-14 pb-20 sm:px-8 sm:pt-20 lg:pt-24 lg:pb-28">
  <div class="mx-auto max-w-4xl text-center">
    <span
      class="inline-flex items-center gap-2 rounded-full bg-mint-100 px-3 py-1 text-xs font-medium text-mint-600"
    >
      <span class="size-1.5 rounded-full bg-mint-600" aria-hidden="true"></span>
      {copy.eyebrow}
    </span>

    <TypingHeadline
      text={copy.headline}
      speed={typingSpeed}
      hold={2600}
      class="mt-6 text-[2.5rem] leading-[1.04] font-semibold tracking-[-0.045em] text-balance text-ink-900 sm:text-6xl lg:text-[4.4rem]"
    />

    <p
      class="mx-auto mt-6 max-w-2xl text-base leading-relaxed text-ink-600 sm:text-lg"
    >
      {copy.lede}
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a href="/boards" class={primaryCtaClass}>
        {copy.primaryCta}
        <svg
          viewBox="0 0 16 16"
          class="size-4"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M3 8h10M9 4l4 4-4 4" />
        </svg>
      </a>
      <a href="/register" class={secondaryCtaClass}>
        {copy.secondaryCta}
      </a>
    </div>
  </div>

  <div id="minggu-ini" class="mt-14 scroll-mt-24 sm:mt-20">
    <WeekSpineStatic copy={copy} />
  </div>
</section>
