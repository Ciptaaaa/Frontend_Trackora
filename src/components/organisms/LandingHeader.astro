---
import Logo from '../atoms/Logo.tsx';
import LocaleLinks from '../molecules/LocaleLinks.astro';
import LandingThemeToggle from '../molecules/LandingThemeToggle.astro';
import type { Locale } from '../../i18n';
import type { LandingCopy } from '../../i18n/landing';

interface Props {
  locale: Locale;
  copy: LandingCopy;
}

const { locale, copy } = Astro.props;
---

<header class="sticky top-0 z-40 sm:top-3 sm:px-4">
  <div
    class="mx-auto flex h-14 max-w-6xl items-center gap-2 border-b border-paper-300 bg-paper-50 px-3 sm:gap-3 sm:rounded-xl sm:border sm:px-4 sm:shadow-sm sm:shadow-black/[0.03] dark:border-paper-400"
  >
    <a
      href="/"
      class="inline-flex min-h-11 items-center rounded-lg transition-opacity hover:opacity-80"
      aria-label="Trackora"
    >
      <Logo />
    </a>

    <span class="hidden h-5 w-px bg-paper-300 xl:block" aria-hidden="true"></span>
    <span class="hidden max-w-36 truncate text-[11px] font-medium text-ink-400 xl:block">
      {copy.eyebrow}
    </span>

    <nav class="ml-auto hidden items-center gap-0.5 md:flex">
      <a
        href="#tampilan"
        class="inline-flex h-11 items-center rounded-lg px-3 text-[13px] font-medium text-ink-600 transition-colors hover:bg-paper-100 hover:text-ink-900 lg:h-9"
      >
        {copy.navOverview}
      </a>
      <a
        href="#prinsip"
        class="inline-flex h-11 items-center rounded-lg px-3 text-[13px] font-medium text-ink-600 transition-colors hover:bg-paper-100 hover:text-ink-900 lg:h-9"
      >
        {copy.navHow}
      </a>
      <a
        href="#mulai"
        class="inline-flex h-11 items-center rounded-lg px-3 text-[13px] font-medium text-ink-600 transition-colors hover:bg-paper-100 hover:text-ink-900 lg:h-9"
      >
        {copy.navStart}
      </a>
    </nav>

    <a
      href="#minggu-ini"
      class="hidden items-center gap-2 rounded-full border border-paper-300 bg-paper-100 px-3 py-1.5 text-[11px] font-medium text-ink-600 transition-colors hover:border-petrol-200 hover:bg-petrol-50 hover:text-petrol-700 lg:inline-flex dark:border-paper-400"
    >
      <span class="size-1.5 rounded-full bg-petrol-600" aria-hidden="true"></span>
      {copy.weekEyebrow}
    </a>

    <div class="ml-auto flex items-center gap-1.5 sm:gap-2 lg:ml-2">
      <span class="sm:hidden">
        <LandingThemeToggle copy={copy} compact />
      </span>
      <span class="hidden sm:block">
        <LandingThemeToggle copy={copy} />
      </span>
      <span class="hidden lg:block">
        <LocaleLinks current={locale} />
      </span>
      <a
        href="/login"
        class="hidden min-h-11 items-center rounded-lg px-3 text-sm font-medium text-ink-600 transition-colors hover:bg-paper-100 hover:text-ink-900 sm:inline-flex"
      >
        {copy.signInCta}
      </a>
      <a
        href="/register"
        class="inline-flex h-11 items-center justify-center rounded-lg bg-petrol-600 px-4 text-sm font-medium text-onaccent shadow-sm shadow-petrol-600/20 transition-colors hover:bg-petrol-700"
      >
        {copy.primaryCta}
      </a>
    </div>
  </div>
</header>
