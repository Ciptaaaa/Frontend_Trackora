---
import Logo from '../atoms/Logo.tsx';
import Eyebrow from '../atoms/Eyebrow.astro';
import LocaleLinks from '../molecules/LocaleLinks.astro';
import type { Locale } from '../../i18n';
import type { LandingCopy } from '../../i18n/landing';

/*
  Footer memakai permukaan gelap tetap (`nav-*`), sama seperti sidebar
  aplikasi. Variabel itu tidak berubah saat tema diganti, jadi warnanya
  konsisten di light maupun dark — dan pemilih bahasa di sini perlu varian
  `nav` agar tetap terbaca di atasnya.
*/
interface Props {
  locale: Locale;
  copy: LandingCopy;
}

const { locale, copy } = Astro.props;
---

<footer class="bg-nav-surface">
  <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8">
    <div class="flex flex-col gap-10 sm:flex-row sm:items-start sm:justify-between">
      <div class="max-w-sm">
        <Logo tone="inverse" />
        <p class="mt-5 text-sm leading-relaxed text-nav-muted">
          {copy.footerNote}
        </p>
        <a
          href="/register"
          class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-nav-text underline decoration-nav-border decoration-2 underline-offset-4 transition-colors hover:decoration-saffron-400"
        >
          {copy.footerCta}
        </a>
      </div>

      <div class="sm:text-right">
        <Eyebrow text={copy.localeEyebrow} tone="nav" />
        <div class="mt-3 sm:flex sm:justify-end">
          <LocaleLinks current={locale} tone="nav" />
        </div>
      </div>
    </div>
  </div>
</footer>
