---
import Eyebrow from '../atoms/Eyebrow.astro';
import type { LandingCopy } from '../../i18n/landing';

interface Props {
  copy: LandingCopy;
}

const { copy } = Astro.props;
---

<section id="prinsip" class="scroll-mt-24 bg-paper-50">
  <div
    class="mx-auto grid max-w-6xl gap-12 px-5 py-20 sm:px-8 lg:grid-cols-[1.05fr_0.95fr] lg:gap-20 lg:py-28"
  >
    <div>
      <Eyebrow text={copy.principlesEyebrow} />
      <h2
        class="mt-4 max-w-xl text-3xl leading-[1.12] font-semibold tracking-[-0.03em] text-balance text-ink-900 sm:text-4xl"
      >
        {copy.principlesHeading}
      </h2>
      <p class="mt-5 max-w-lg text-sm leading-relaxed text-ink-600 sm:text-base">
        {copy.principlesBody}
      </p>

      <div
        class="mt-10 max-w-lg rounded-xl border border-paper-300 bg-paper-100 px-5 py-4 dark:border-paper-400"
      >
        <p class="text-xs font-medium text-ink-400">{copy.weekEyebrow}</p>
        <div class="mt-3 grid grid-cols-7 gap-1">
          {
            copy.dayInitials.map((initial, index) => (
              <div
                class:list={[
                  'flex flex-col items-center gap-1 rounded-md px-0.5 py-1',
                  index === 3
                    ? 'bg-petrol-50 text-petrol-700'
                    : 'text-ink-400',
                ]}
              >
                <span class="text-[9px] font-medium">{initial}</span>
                <span class="text-[11px] font-semibold tabular-nums">
                  {index + 1}
                </span>
                <span
                  class:list={[
                    'size-1 rounded-full',
                    [1, 3, 5].includes(index) ? 'bg-petrol-600' : 'bg-transparent',
                  ]}
                />
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <ul class="space-y-8">
      {
        copy.principles.map((principle, index) => (
          <li class="border-t border-paper-300 pt-5">
            <span class="text-[11px] font-semibold text-petrol-700 tabular-nums">
              {String(index + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-2 text-lg leading-tight font-semibold tracking-[-0.01em] text-ink-900">
              {principle.title}
            </h3>
            <p class="mt-1.5 max-w-md text-sm leading-relaxed text-ink-600">
              {principle.body}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
