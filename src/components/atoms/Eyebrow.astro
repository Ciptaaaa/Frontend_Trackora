---
/*
  Label kecil di atas judul. Dipakai untuk menandai bagian halaman, bukan untuk
  hiasan — kalau sebuah bagian tidak punya nama yang berguna, eyebrow-nya
  sebaiknya tidak ada.

  Berbasis <p> dan bukan heading supaya tidak ikut masuk struktur outline
  dokumen; pembaca layar sudah mendapat urutannya dari h1/h2 di bawahnya.
*/
interface Props {
  text: string;
  tone?: 'ink' | 'nav';
}

const { text, tone = 'ink' } = Astro.props;

const toneClass = tone === 'nav' ? 'text-nav-muted' : 'text-ink-400';
---

<p
  class:list={[
    'font-mono text-[11px] tracking-[0.18em] uppercase',
    toneClass,
  ]}
>
  {text}
</p>
